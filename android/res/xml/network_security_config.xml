<?xml version="1.0" encoding="utf-8"?>
<!-- Bravin cần http (không mã hoá) tới:
     - máy chủ nội bộ 127.0.0.1 của app (LocalServer);
     - LocalMiniDrama (khu Phim AI) chạy trên máy tính trong cùng Wi-Fi, ví dụ http://192.168.1.5:5679.
     Địa chỉ mạng nội bộ không khai báo trước được (Android không nhận dải IP), nên cho phép http chung.
     Mọi dịch vụ ngoài mà Bravin tự gọi (AI, phông chữ, Hugging Face) đều dùng https.
     Tin tưởng chứng chỉ hệ thống, không tin chứng chỉ người dùng tự cài. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
